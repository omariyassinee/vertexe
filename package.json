{
  "name": "vertexe",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "scripts": {
    "with-env": "bun --env-file .env",
    "with-env:dev": "NODE_ENV=development bun --env-file .env",

    "dev": "bun with-env:dev src/server.ts --watch",
    "build": "bun build src/server.ts --splitting --outdir dist --minify --target bun",
    "preview": "bun run dist/server.js",
    "preview:background": "setsid nohup bun run preview > server.log 2>&1 < /dev/null &",
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "cloudflare": "^7.3.0"
  }
}

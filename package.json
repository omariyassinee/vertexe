{
  "name": "vertexe",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "scripts": {
    "dev": "bun run src/server.ts --watch",
    "build": "bun build src/server.ts --splitting --outdir dist --minify --target bun",
